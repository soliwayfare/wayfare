---
// Keep the current page visible until the next page is ready. Only slow
// navigations show a progress indicator; swapping never hides the content.
---

<div id="nav-loading" class="nav-loading" aria-hidden="true" transition:persist>
  <span class="nav-loading__spinner"></span>
</div>

<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

  // Wire once per session; <ClientRouter /> keeps the same window so these
  // document-level listeners survive navigations.
  const w = window as any;
  if (!w.__navLoading) {
    w.__navLoading = true;
    document.addEventListener('astro:before-swap', (event) => {
      (event as TransitionBeforeSwapEvent).viewTransition.skipTransition();
    });
    const root = document.documentElement;
    const SPINNER_DELAY = 150; // don't show the spinner for faster loads
    let showTimer: number | undefined;

    document.addEventListener('astro:before-preparation', () => {
      // Reveal the spinner only if the load is taking a while.
      clearTimeout(showTimer);
      showTimer = window.setTimeout(() => {
        root.classList.add('is-loading');
      }, SPINNER_DELAY);
    });

    document.addEventListener('astro:after-preparation', () => {
      clearTimeout(showTimer);
      root.classList.remove('is-loading');
    });
  }
</script>

<style is:global>
  .nav-loading {
    /* Centered in the content column, below the sticky header — not a
       full-screen overlay. */
    position: fixed;
    left: 0;
    right: 0;
    top: max(38vh, 12rem);
    z-index: 40;
    display: flex;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  /* Only shown once a navigation is slow enough (is-loading), not merely while
     navigating. */
  html.is-loading .nav-loading {
    opacity: 1;
    visibility: visible;
  }

  .nav-loading__spinner {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 3px solid color-mix(in srgb, var(--ink) 16%, transparent);
    border-top-color: var(--accent);
    animation: nav-spin 0.7s linear infinite;
  }

  @keyframes nav-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-loading__spinner {
      animation-duration: 1.4s;
    }
  }
</style>
